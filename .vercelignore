# Aggressive exclusions for Vercel - keep bundle under 500MB
# Vercel .vercelignore - Exclude all non-essential files

# Large directories
Data/
docs/
images/
backup_apis/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
node_modules/
venv/
env/

# Development files
*.ipynb
*.pyc
*.pyo
*.pyd
*.so
.DS_Store
Thumbs.db

# Testing
test_*.py
tests/
*_test.py
pytest.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore
.gitattributes

# Documentation (keep only essential)
*.md
DEPLOYMENT_*
!README.md

# Optional development tools
setup.py
setup.cfg
tox.ini
.coverage
coverage.xml

# Temporary
*.tmp
*.log
tmp/
temp/